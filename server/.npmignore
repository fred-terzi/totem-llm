# This file intentionally overrides server/.gitignore for npm packaging.
# server/.gitignore excludes public/ (the dev build output), but the npm
# package must include server/public/ — the pre-built frontend copied here
# by scripts/build-frontend.mjs during prepublishOnly.
#
# IMPORTANT: because this file exists, the root .npmignore rules do NOT
# propagate into server/ — every exclusion must be stated explicitly here.

# Dependencies — installed at runtime by postinstall, never ship these
node_modules/

# Secrets and local environment overrides
.env.development
.env.production
.env.test
.env.test.*

# Runtime data — created at first run, not part of the package
storage/
logs/
sslcert/
*.db
*.db-journal

# Development tooling
nodemon.json
swagger/
__tests__/
*.test.js
*.spec.js
eslint.config.mjs
