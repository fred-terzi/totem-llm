# Totem LLM — Venice AI hosted container configuration
# Provider is locked to Venice AI. Do not change.
#
# SECURITY: VENICE_API_KEY is intentionally ABSENT from this file.
# It is injected at container creation time via:
#     docker run -e VENICE_API_KEY=<key> totem-venice:latest
# This keeps the key in the container env layer only.

STORAGE_DIR="/app/totem-storage"
SERVER_PORT=8686
COLLECTOR_PORT=8888

# Security secrets — replaced with random values at image build time
JWT_SECRET="__JWT_SECRET__"
SIG_KEY="__SIG_KEY__"
SIG_SALT="__SIG_SALT__"

# LLM Provider — Venice AI (locked)
LLM_PROVIDER=venice
# VENICE_API_KEY=     ← injected via docker run -e, NOT here
# VENICE_MODEL_PREF=  ← optional, set via docker run -e
# VENICE_MAX_TOKENS=  ← optional, max output tokens (default 1024)

# Embedding Engine — native/local (no external API needed)
EMBEDDING_ENGINE=native
EMBEDDING_MODEL_PREF=Xenova/all-MiniLM-L6-v2

# Vector database — LanceDB (zero-setup, file-based)
VECTOR_DB=lancedb

# Telemetry
DISABLE_TELEMETRY=true
