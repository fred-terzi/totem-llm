# ──────────────────────────────────────────────────────────────────────────
# Totem LLM (Venice AI) — Environment Variables
#
# Copy this file to .env and fill in your key, OR (recommended) export
# VENICE_API_KEY in your shell before running docker compose.
#
#   cp .env.example .env
#   nano .env
#   docker compose -f docker/venice/docker-compose.yml up
#
# SECURITY NOTE:
#   VENICE_API_KEY is intentionally NOT stored inside the image or in the
#   container's /app/totem-storage/.env file. It lives only in the container's
#   environment layer (injected via `docker run -e` or compose `environment:`).
#   This is the "completely hidden" mechanism from the hosted totem plan.
# ──────────────────────────────────────────────────────────────────────────

# ── REQUIRED ────────────────────────────────────────────────────────────────
# Your Venice AI API key (from https://venice.ai/settings)
VENICE_API_KEY=

# ── OPTIONAL: LLM model ─────────────────────────────────────────────────────
# Default: zai-org-glm-5-1 (a strong general-purpose model on Venice)
# See https://venice.ai/docs for the full model list.
# VENICE_MODEL_PREF=zai-org-glm-5-1
# VENICE_MODEL_PREF=kimi-k2-6
# VENICE_MODEL_PREF=zai-org-glm-4-6-1m
#
# Max output tokens per response (default 1024)
# VENICE_MAX_TOKENS=2048

# ── OPTIONAL: ports ─────────────────────────────────────────────────────────
# SERVER_PORT=8686
# COLLECTOR_PORT=8888

# ── OPTIONAL: storage ───────────────────────────────────────────────────────
# TOTEM_STORAGE_DIR=/app/totem-storage
