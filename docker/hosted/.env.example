# ──────────────────────────────────────────────────────────────────────────────
# Totem LLM — Hosted Platform Environment
# Copy to .env and fill in your values:
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────────────────────

# ── Venice AI (LLM + Embeddings) ─────────────────────────────────────────────
VENICE_API_KEY=sk-your-venice-master-key
VENICE_LLM_MODEL_PREF=claude-sonnet-4
VENICE_EMBEDDING_MODEL_PREF=embedding-model

# ── Wallet Auth (SIWE) ───────────────────────────────────────────────────────
# Domain that users will use to access the platform.
# Must match the domain in the SIWE message.
WALLET_AUTH_DOMAIN=localhost
# Allowed chain IDs (comma-separated). 1=Mainnet, 8453=Base
WALLET_AUTH_CHAINS=1,8453

# ── Coinbase Commerce (credit purchases) ─────────────────────────────────────
COINBASE_COMMERCE_KEY=sk_your_coinbase_commerce_secret_key

# ── Alchemy (NFT holdings check) ─────────────────────────────────────────────
ALCHEMY_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
# NFT contract to check for premium access (optional, Phase 1b)
NFT_PREMIUM_CONTRACT=
NFT_PREMIUM_CHAIN_ID=1

# ── CoinGecko MCP ────────────────────────────────────────────────────────────
# If CoinGecko requires an API key for higher rate limits:
COINGECKO_API_KEY=

# ── Server ───────────────────────────────────────────────────────────────────
SERVER_PORT=8686
COLLECTOR_PORT=8888

# ── Vector DB ────────────────────────────────────────────────────────────────
VECTOR_DB=lancedb

# ── Misc ─────────────────────────────────────────────────────────────────────
DISABLE_TELEMETRY=true
DISABLE_SWAGGER_DOCS=true
