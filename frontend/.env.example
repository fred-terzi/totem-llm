VITE_API_BASE='/api' # Relative path, proxied through Vite dev server to backend on :8686
# VITE_API_BASE="https://$CODESPACE_NAME-3001.$GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN/api" # for GitHub Codespaces
# VITE_API_BASE='/api' # Use this URL deploying on non-localhost address OR in docker.

# WalletConnect (Reown) Project ID — enables the mobile "Open in MetaMask" + QR login.
# Free at https://dashboard.reown.com → create project → add domain. Leave unset to hide the mobile section.
# VITE_WC_PROJECT_ID=<your-project-id>
